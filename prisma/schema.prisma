generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

enum Plan {
  ATELIER
  RESEAU
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

model Garage {
  id           String   @id @default(cuid())
  name         String
  address      String   @default("")
  phone        String   @default("")
  email        String   @default("")
  siret        String   @default("")
  vatRate      Decimal  @default(20.00) @db.Decimal(5, 2)
  workOrderSeq Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Abonnement (SaaS) ---------------------------------------------------
  plan                 Plan               @default(ATELIER)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime           @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  suspendedAt          DateTime?
  suspendedReason      String             @default("")

  /// Provenance déclarée à l'inscription (utm_source ou ref), sans identifiant individuel.
  acquisitionSource String @default("")

  users      User[]
  customers  Customer[]
  vehicles   Vehicle[]
  workOrders WorkOrder[]
  photos     Photo[]
  findings   Finding[]
  damages    Damage[]
  checklist  ChecklistItem[]
  estimates  Estimate[]
  events     TimelineEvent[]
  audits     AuditLog[]
  approvals  Approval[]
  leads      Lead[]
}

enum Role {
  OWNER
  RECEPTION
  TECHNICIAN
}

model User {
  id            String   @id @default(cuid())
  garageId      String
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role     @default(TECHNICIAN)
  active        Boolean  @default(true)
  /// Accès à la console plateforme (/admin). Hors périmètre du garage.
  platformAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  garage         Garage               @relation(fields: [garageId], references: [id], onDelete: Cascade)
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  assignedOrders WorkOrder[]          @relation("Technician")
  createdOrders  WorkOrder[]          @relation("CreatedBy")
  photos         Photo[]
  findings       Finding[]
  damages        Damage[]
  checklistItems ChecklistItem[]
  events         TimelineEvent[]
  audits         AuditLog[]
  approvalTokens ApprovalToken[]
  finalChecks    FinalCheck[]

  @@index([garageId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Customers & vehicles
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  garageId  String
  firstName String
  lastName  String
  phone     String   @default("")
  email     String   @default("")
  address   String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garage     Garage      @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicles   Vehicle[]
  workOrders WorkOrder[]

  @@index([garageId, lastName, firstName])
  @@index([garageId, phone])
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  OTHER
}

model Vehicle {
  id         String   @id @default(cuid())
  garageId   String
  customerId String
  plate      String
  vin        String   @default("")
  make       String
  model      String
  year       Int?
  fuel       FuelType @default(DIESEL)
  mileage    Int      @default(0)
  color      String   @default("")
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  garage     Garage      @relation(fields: [garageId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@unique([garageId, plate])
  @@index([garageId, vin])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Work orders (intervention files)
// ---------------------------------------------------------------------------

enum WorkOrderStatus {
  ARRIVED
  WAITING_DIAGNOSIS
  DIAGNOSIS_IN_PROGRESS
  WAITING_CUSTOMER_APPROVAL
  APPROVED
  PARTIALLY_APPROVED
  WAITING_PARTS
  REPAIR_IN_PROGRESS
  QUALITY_CONTROL
  READY_FOR_PICKUP
  DELIVERED
  CLOSED
  CANCELLED
}

model WorkOrder {
  id           String          @id @default(cuid())
  garageId     String
  number       String
  customerId   String
  vehicleId    String
  technicianId String?
  createdById  String
  status       WorkOrderStatus @default(ARRIVED)
  mileageIn    Int
  mileageOut   Int?
  reason       String
  symptoms     String          @default("")
  promisedAt   DateTime?
  deliveredAt  DateTime?
  closedAt     DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  garage     Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  technician User?           @relation("Technician", fields: [technicianId], references: [id], onDelete: SetNull)
  createdBy  User            @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  photos     Photo[]
  findings   Finding[]
  damages    Damage[]
  checklist  ChecklistItem[]
  estimates  Estimate[]
  events     TimelineEvent[]
  finalCheck FinalCheck?

  @@unique([garageId, number])
  @@index([garageId, status])
  @@index([vehicleId])
  @@index([customerId])
  @@index([technicianId])
}

enum PhotoType {
  FRONT
  REAR
  LEFT
  RIGHT
  INTERIOR
  DASHBOARD
  DAMAGE
  FINDING
  CHECKLIST
  OTHER
}

model Photo {
  id          String    @id @default(cuid())
  garageId    String
  workOrderId String
  type        PhotoType @default(OTHER)
  storageKey  String    @unique
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  comment     String    @default("")
  authorId    String
  findingId   String?
  damageId    String?
  checklistId String?
  createdAt   DateTime  @default(now())

  garage    Garage         @relation(fields: [garageId], references: [id], onDelete: Cascade)
  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  finding   Finding?       @relation(fields: [findingId], references: [id], onDelete: SetNull)
  damage    Damage?        @relation(fields: [damageId], references: [id], onDelete: SetNull)
  checklist ChecklistItem? @relation(fields: [checklistId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([garageId])
}

enum DamageType {
  SCRATCH
  DENT
  IMPACT
  RIM
  WINDSHIELD
  OTHER
}

model Damage {
  id          String     @id @default(cuid())
  garageId    String
  workOrderId String
  type        DamageType
  location    String
  description String     @default("")
  authorId    String
  createdAt   DateTime   @default(now())

  garage    Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  photos    Photo[]

  @@index([workOrderId])
}

enum Urgency {
  INFO
  WATCH
  RECOMMENDED
  URGENT
  CRITICAL
}

model Finding {
  id          String   @id @default(cuid())
  garageId    String
  workOrderId String
  title       String
  category    String
  description String   @default("")
  urgency     Urgency  @default(INFO)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  garage    Garage         @relation(fields: [garageId], references: [id], onDelete: Cascade)
  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  photos    Photo[]
  lines     EstimateLine[]

  @@index([workOrderId])
}

enum CheckStatus {
  NOT_CHECKED
  OK
  WATCH
  RECOMMENDED
  URGENT
}

model ChecklistItem {
  id          String      @id @default(cuid())
  garageId    String
  workOrderId String
  key         String
  status      CheckStatus @default(NOT_CHECKED)
  comment     String      @default("")
  updatedById String?
  updatedAt   DateTime    @updatedAt

  garage    Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  photos    Photo[]

  @@unique([workOrderId, key])
}

// ---------------------------------------------------------------------------
// Estimates & customer approval
// ---------------------------------------------------------------------------

enum EstimateStatus {
  DRAFT
  SENT
  DECIDED
  SUPERSEDED
}

model Estimate {
  id          String         @id @default(cuid())
  garageId    String
  workOrderId String
  version     Int
  status      EstimateStatus @default(DRAFT)
  note        String         @default("")
  sentAt      DateTime?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  garage    Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  workOrder WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  lines     EstimateLine[]
  tokens    ApprovalToken[]
  approval  Approval?

  @@unique([workOrderId, version])
  @@index([garageId])
}

enum LineDecision {
  PENDING
  ACCEPTED
  REFUSED
}

enum WorkStatus {
  TODO
  DONE
}

model EstimateLine {
  id          String       @id @default(cuid())
  estimateId  String
  findingId   String?
  position    Int          @default(0)
  title       String
  description String       @default("")
  partsPrice  Decimal      @db.Decimal(10, 2)
  laborPrice  Decimal      @db.Decimal(10, 2)
  vatRate     Decimal      @db.Decimal(5, 2)
  totalHt     Decimal      @db.Decimal(10, 2)
  vatAmount   Decimal      @db.Decimal(10, 2)
  totalTtc    Decimal      @db.Decimal(10, 2)
  urgency     Urgency      @default(RECOMMENDED)
  decision    LineDecision @default(PENDING)
  workStatus  WorkStatus   @default(TODO)
  createdAt   DateTime     @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  finding  Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([estimateId])
}

model ApprovalToken {
  id          String    @id @default(cuid())
  estimateId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdById String
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  estimate  Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([estimateId])
}

model Approval {
  id            String   @id @default(cuid())
  garageId      String
  estimateId    String   @unique
  acceptedTotal Decimal  @db.Decimal(10, 2)
  refusedTotal  Decimal  @db.Decimal(10, 2)
  acceptedCount Int
  refusedCount  Int
  customerName  String   @default("")
  comment       String   @default("")
  ip            String   @default("")
  userAgent     String   @default("")
  snapshot      Json
  decidedAt     DateTime @default(now())

  garage   Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Final check, timeline, audit
// ---------------------------------------------------------------------------

model FinalCheck {
  id            String   @id @default(cuid())
  workOrderId   String   @unique
  roadTest      Boolean  @default(false)
  fluids        Boolean  @default(false)
  warningLights Boolean  @default(false)
  toolsRemoved  Boolean  @default(false)
  cleaned       Boolean  @default(false)
  comment       String   @default("")
  checkedById   String
  checkedAt     DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  checkedBy User      @relation(fields: [checkedById], references: [id], onDelete: Restrict)
}

model TimelineEvent {
  id          String   @id @default(cuid())
  garageId    String
  workOrderId String
  type        String
  message     String
  actorId     String?
  actorLabel  String   @default("")
  payload     Json?
  createdAt   DateTime @default(now())

  garage    Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  garageId   String?
  userId     String?
  action     String
  entityType String
  entityId   String   @default("")
  metadata   Json?
  ip         String   @default("")
  createdAt  DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([garageId, createdAt])
}

// ---------------------------------------------------------------------------
// Prospection (console plateforme uniquement, jamais visible des garages)
// ---------------------------------------------------------------------------

enum LeadStage {
  DISCOVERED
  QUALIFIED
  READY_FOR_REVIEW
  CONTACTED
  REPLIED
  DEMO_BOOKED
  TRIAL
  CONVERTED
  NOT_INTERESTED
  DO_NOT_CONTACT
}

enum LeadSource {
  SIRENE
  CSV_IMPORT
  MANUAL
  INBOUND_DEMO
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

/// Garage prospecté. Uniquement des données d'entreprise publiques ou fournies
/// par le prospect lui-même, chacune avec sa source.
model Lead {
  id                  String    @id @default(cuid())
  /// SIRET (établissement) quand la source est SIRENE ou qu'il est connu.
  siret               String?   @unique
  siren               String    @default("")
  name                String
  address             String    @default("")
  postalCode          String    @default("")
  city                String    @default("")
  zone                String    @default("")
  nafCode             String    @default("")
  companyCreatedOn    DateTime?
  /// Code « tranche d'effectif salarié » INSEE (ex. « 01 » = 1 ou 2 salariés).
  workforceRange      String    @default("")
  establishmentsCount Int?
  /// Clé de dédoublonnage : SIRET, sinon nom normalisé + code postal.
  dedupeKey           String    @unique

  website          String    @default("")
  websiteSignals   Json?
  websiteCheckedAt DateTime?
  email            String    @default("")
  emailSourceUrl   String    @default("")
  phone            String    @default("")
  phoneSourceUrl   String    @default("")
  contactName      String    @default("")

  source          LeadSource
  sourceUrl       String
  sourceFetchedAt DateTime

  stage         LeadStage  @default(DISCOVERED)
  score         Int        @default(0)
  confidence    Confidence @default(LOW)
  /// Liste des signaux retenus : { key, label, points, evidence, sourceUrl, observedAt }.
  scoreEvidence Json?
  hypothesis    String     @default("")
  scoredAt      DateTime?

  demoRequestedAt DateTime?
  demoMessage     String    @default("")
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  objection       String    @default("")
  optedOutAt      DateTime?

  /// Garage inscrit correspondant, une fois l'essai démarré.
  garageId String?
  garage   Garage? @relation(fields: [garageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  drafts     OutreachDraft[]

  @@index([stage])
  @@index([zone])
  @@index([score])
  @@index([email])
  @@index([nextFollowUpAt])
  @@index([garageId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  message   String
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

enum DraftKind {
  FIRST_CONTACT
  DEMO_INVITE
  FOLLOW_UP
}

enum DraftStatus {
  DRAFT
  APPROVED
  SENT
  DISCARDED
}

/// Message préparé pour un prospect. Rien ne part sans approbation humaine.
model OutreachDraft {
  id           String      @id @default(cuid())
  leadId       String
  kind         DraftKind
  status       DraftStatus @default(DRAFT)
  toEmail      String      @default("")
  subject      String
  body         String
  /// « template » ou « ai:<modèle> ».
  generator    String
  approvedById String?
  approvedAt   DateTime?
  sentById     String?
  sentAt       DateTime?
  /// « smtp » (envoi depuis GarageFlow) ou « manual » (envoyé par l'admin depuis sa messagerie).
  sentVia      String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status, sentAt])
}

enum SuppressionKind {
  EMAIL
  DOMAIN
  SIRET
}

/// Liste d'opposition : consultée avant chaque préparation et chaque envoi.
model SuppressionEntry {
  id        String          @id @default(cuid())
  kind      SuppressionKind
  value     String
  reason    String          @default("")
  /// « unsubscribe_link », « admin », « reply ».
  origin    String
  createdAt DateTime        @default(now())

  @@unique([kind, value])
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model GrowthJobRun {
  id             String    @id @default(cuid())
  job            String
  /// job + période (+ « dry ») : une seule exécution réussie par période.
  idempotencyKey String    @unique
  dryRun         Boolean   @default(false)
  status         JobStatus @default(RUNNING)
  attempts       Int       @default(1)
  trigger        String    @default("")
  stats          Json?
  error          String    @default("")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([job, startedAt])
}

/// Journal des appels au modèle : coût estimé à partir des jetons facturés.
model AiUsage {
  id           String   @id @default(cuid())
  purpose      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// Coût estimé en micro-dollars.
  costMicroUsd Int      @default(0)
  leadId       String?
  ok           Boolean  @default(true)
  error        String   @default("")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Réglages de la prospection (ligne unique id = "global").
model GrowthSettings {
  id                 String   @id @default("global")
  /// Arrêt d'urgence : plus aucune tâche planifiée ni aucun envoi.
  paused             Boolean  @default(false)
  aiEnabled          Boolean  @default(false)
  aiMonthlyBudgetUsd Int      @default(10)
  updatedById        String?
  updatedAt          DateTime @updatedAt
}

/// Mesure d'audience agrégée : ni cookie, ni IP, ni identifiant.
model PageView {
  day    DateTime @db.Date
  path   String
  source String
  count  Int      @default(0)

  @@id([day, path, source])
}
