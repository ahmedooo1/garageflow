[Unit]
Description=GarageFlow prospection : préparation des brouillons (sans envoi)

[Timer]
OnCalendar=*-*-* 05:57:00 UTC
# Rattrape une exécution manquée (serveur éteint) ; la tâche est idempotente par période.
Persistent=true
RandomizedDelaySec=3min
Unit=garageflow-growth@drafts.service

[Install]
WantedBy=timers.target
