[Unit]
Description=GarageFlow prospection : vérification des sites

[Timer]
OnCalendar=*-*-* 05:37:00 UTC
# Rattrape une exécution manquée (serveur éteint) ; la tâche est idempotente par période.
Persistent=true
RandomizedDelaySec=3min
Unit=garageflow-growth@enrich.service

[Install]
WantedBy=timers.target
