# --- Base de donnees --------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garageflow?schema=public"

# --- Application ------------------------------------------------------------
# URL publique (utilisee pour generer les liens envoyes aux clients)
APP_URL="http://localhost:3000"
# Secret 32+ caracteres : signature des URLs de fichiers locales. Generer avec : openssl rand -hex 32
APP_SECRET="change-me-with-a-long-random-secret-of-at-least-32-chars"
# Duree de validite des liens de validation client (heures)
APPROVAL_LINK_TTL_HOURS=72

# --- Stockage des photos ----------------------------------------------------
# "local" : fichiers sur disque (STORAGE_LOCAL_DIR), URLs signees HMAC.
# "s3"    : bucket S3-compatible (AWS S3, MinIO, Scaleway, OVH...), URLs presignees.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="garageflow"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# --- Emails -----------------------------------------------------------------
# "log"  : le contenu est ecrit dans les logs serveur (dev / demo).
# "smtp" : envoi reel via les variables SMTP_* ci-dessous.
MAIL_TRANSPORT="log"
MAIL_FROM="GarageFlow <no-reply@exemple.fr>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Facturation Stripe (optionnel) -----------------------------------------
# Sans ces variables, l'application fonctionne : les abonnements sont actives
# manuellement depuis la console plateforme (/admin).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Identifiants de prix recurrents mensuels crees dans le tableau de bord Stripe
STRIPE_PRICE_ATELIER=""
STRIPE_PRICE_RESEAU=""

# --- Prospection (console /admin, optionnel) ----------------------------------
# Identité de l'expéditeur, obligatoire pour approuver un message (LCEN, RGPD art. 14).
OUTREACH_SENDER_NAME=""
OUTREACH_SENDER_COMPANY=""
OUTREACH_SENDER_ADDRESS=""
# Facultatif : SIREN de l'éditeur (9 chiffres), ajouté au pied de message.
OUTREACH_SENDER_SIREN=""
# Expéditeur et adresse de réponse des messages de prospection (sinon MAIL_FROM).
OUTREACH_FROM=""
OUTREACH_REPLY_TO=""
# "true" : bouton d'envoi SMTP depuis la console (un message à la fois, après approbation).
# Par défaut, l'admin envoie depuis sa propre messagerie puis marque le message comme envoyé.
OUTREACH_SEND_ENABLED="false"
OUTREACH_DAILY_LIMIT="20"
# Tâches planifiées : appelées par le cron du serveur (POST /api/growth/cron). Vide = désactivées.
GROWTH_CRON_SECRET=""
# Destinataire interne des notifications (demande de démo) et du rapport hebdomadaire.
GROWTH_REPORT_TO=""
# Zones parcourues : elbeuf, rouen, rouen-metropole, le-havre.
GROWTH_DISCOVERY_ZONES="elbeuf,rouen,le-havre"
GROWTH_DISCOVERY_MAX_PAGES="4"
GROWTH_WEBSITE_CHECKS_PER_RUN="15"
GROWTH_DRAFTS_PER_RUN="10"
# "1" : arrêt d'urgence côté serveur (en plus de la case de la console).
GROWTH_KILL_SWITCH=""
# Rédaction assistée des brouillons (facultative, budget réglé dans la console).
ANTHROPIC_API_KEY=""
GROWTH_AI_MODEL="claude-opus-5-5"
